{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(flutter gen-l10n *)",
      "Bash(flutter doctor *)",
      "Bash(dart format *)",
      "Bash(dart analyze *)",
      "Bash(dart run build_runner *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx wrangler whoami *)",
      "Bash(npx wrangler deploy --dry-run *)",
      "Bash(adb devices *)",
      "Bash(adb logcat *)",
      "Bash(adb shell pidof *)",
      "Bash(adb shell dumpsys *)",
      "Bash(adb shell getprop *)",
      "Bash(adb shell wm size *)",
      "Bash(adb shell am start *)",
      "Bash(adb exec-out screencap *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run.js", "pre-bash"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run.js", "post-edit"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run.js", "post-bash"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run.js", "stop"],
            "timeout": 90
          }
        ]
      }
    ]
  }
}
