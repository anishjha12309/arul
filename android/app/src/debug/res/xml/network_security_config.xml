<?xml version="1.0" encoding="utf-8" ?>
<!-- Lives in src/debug/res -> Gradle's merger uses it in DEBUG builds only -> nothing here can ship. -->
<!-- `adb reverse` points debug at http://127.0.0.1:8787 -> the base config blocks cleartext -> hence this override. -->
<!-- The exception covers loopback addresses only -> every real host still requires TLS, debug builds included. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
