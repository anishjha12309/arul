<?xml version="1.0" encoding="utf-8"?>
<!-- flutter_local_notifications resolves these by NAME, never as R.* -> R8 shrinking strips them. -->
<!-- Stripped names throw `invalid_icon` -> only release builds break, so this file is not optional. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@drawable/ic_notification_large" />
