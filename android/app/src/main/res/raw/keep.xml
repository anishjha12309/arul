<?xml version="1.0" encoding="utf-8"?>
<!-- flutter_local_notifications resolves these by NAME, never as R.* -> R8 shrinking strips them. -->
<!-- Stripped names throw `invalid_icon` and drop the chime -> only the .aab breaks, so this file is not optional. -->
<!-- arul_bell is ABSENT until the audio is supplied -> tools:keep on a missing resource is a harmless no-op. -->
<!-- Chime format and the two-line switch-on: docs/notifications.md. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@drawable/ic_notification_large,@raw/arul_bell" />
