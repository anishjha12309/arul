<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification SMALL icon (status bar).

  Android flattens this to a monochrome silhouette and tints it, so it can NOT be
  the coloured launcher icon — that renders as a solid white square. This is the
  Arul gopuram mark reduced to a filled silhouette: a stepped temple tower on a
  plinth, with a kalasam finial. It reads at 24dp because it is pure mass, no
  strokes and no interior detail.

  The coloured brand mark rides along separately as the notification LARGE icon
  (ic_notification_large). Both are referenced BY NAME from Dart, never as R.*,
  so raw/keep.xml has to protect them from resource shrinking.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Kalasam finial. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,1.4L13.05,3.5L10.95,3.5Z" />
    <!-- Stepped tower: four tiers, each wider than the one above it. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.6,4.4h2.8l0.85,2.1h-4.5Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.3,7.4h5.4l0.95,2.4h-7.3Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7.8,10.7h8.4l1.05,2.6h-10.5Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6.1,14.2h11.8l1.2,3h-14.2Z" />
    <!-- Plinth. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3.6,18.1h16.8v1.6h-16.8Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M2.8,20.5h18.4v2h-18.4Z" />
</vector>
