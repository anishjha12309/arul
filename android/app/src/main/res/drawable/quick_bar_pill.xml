<?xml version="1.0" encoding="utf-8"?>
<!-- The dock's active-tab look (ArulTokens.darkSurface glass, gold edge) -> the bar reads as Arul's own dock.
     A shape draws its own corners on every API level, unlike art clipped by android:clipToOutline (12+ only). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#59D4A017" />
            <stroke android:width="1dp" android:color="#FFD4A017" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B814090C" />
            <stroke android:width="1dp" android:color="#8CD4A017" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
