<?xml version="1.0" encoding="utf-8"?>
<!-- The ACTION_ATTACH_DATA fallback hands the chooser a local image -> a file:// URI throws -> FileProvider serves it. -->
<!-- The wallpaper service reads live MP4s straight from filesDir -> no content:// URI is minted for them. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="cache"
        path="." />
    <files-path
        name="files"
        path="." />
    <external-cache-path
        name="external_cache"
        path="." />
    <external-files-path
        name="external_files"
        path="." />
</paths>
