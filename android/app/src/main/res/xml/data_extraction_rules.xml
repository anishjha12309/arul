<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false stops cloud and adb backup -> it does NOT stop device-to-device transfer. -->
<!-- Secure-storage auth tokens would ride "Copy apps & data" to a new phone -> exclude every domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
