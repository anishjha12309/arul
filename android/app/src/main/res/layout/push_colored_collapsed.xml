<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed content of a coloured campaign (push/ArulMessagingService). Android 12+ caps a decorated
     custom view at 48dp collapsed, so this is one line of title and one of body. The background and
     both text colours are set at runtime; the literals here only show in the layout preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/push_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2B3A8A"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/push_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/push_body"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF" />
</LinearLayout>
