<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Identical to values/styles.xml on purpose -> the launch surface is dark ink in both themes -> the splash never flashes light. -->
    <!-- Platform splash attrs are ignored on API<=30 -> cold start drew a flat iconless field -> keep the compat parent. -->
    <!-- flutter_native_splash:create rewrites this file -> it drops the parent and postSplashScreenTheme -> never run it. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen.IconBackground">
        <!-- NOT brand ink -> a dark field leaves the icon's crimson disc a hard-edged circle -> match the disc's EDGE colour. -->
        <item name="windowSplashScreenBackground">@color/splash_icon_field</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_field</item>
        <!-- minSdk 24 cannot resolve an AdaptiveIconDrawable -> @mipmap/ic_launcher would fail -> use its foreground layer. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- Flutter also sets NormalTheme via manifest meta-data -> both name the same theme -> the set is idempotent. -->
        <item name="postSplashScreenTheme">@style/NormalTheme</item>

        <!-- Arul's launch surface is dark brand ink in BOTH themes -> light icons. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android paints an 80% scrim behind 3-button nav -> the feed draws its own gradient there -> turn it off. -->
        <item name="android:enforceNavigationBarContrast">false</item>

        <!-- Bar colour attrs are ignored at targetSdk 35+ -> re-adding them only misleads -> paint system bars in Flutter. -->
    </style>

    <!-- Flutter's own manifest meta-data names this theme by string -> keep it called NormalTheme. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
