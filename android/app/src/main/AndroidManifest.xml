<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Static wallpaper apply via WallpaperManager. Normal permission, auto-granted.
         Live wallpapers go through the system chooser and need no permission. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <!-- Required to set the device ringtone via RingtoneManager — nothing else
         asks for it; without it every "Set" fails the Settings.System.canWrite
         check on every device. Special-access, shows on the Play listing, so
         the store form has to justify it (ringtones are a live feature —
         docs/known-issues.md §Open). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <!-- Pre-Android-10 ONLY (capped at 28, so it never reaches a modern device or
         the Play listing's runtime-permission list). Below API 29 a custom tone
         must be copied into the PUBLIC Ringtones directory and registered on the
         EXTERNAL MediaStore volume — both need this. Android 10+ uses scoped
         storage and needs nothing. Runtime-prompted at the moment of the first
         "Set" on those devices, never at launch — see MainActivity.setRingtone.
         Same shape as Pakiza's (CLAUDE.md §0: shared behaviour, both repos). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Local devotional reminders (flutter_local_notifications). Runtime-prompted
         on Android 13+ and only when the user turns the feature on in Settings —
         never at launch. Nothing is scheduled while the master toggle is off. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Re-arms the scheduled reminders after a reboot; without it every pending
         notification is silently dropped the first time the phone restarts.
         Paired with ScheduledNotificationBootReceiver below. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Live wallpaper support is OPTIONAL: the app still installs and runs on a
         device without it, and the apply flow degrades to static-only. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <!-- Google Ads App Campaign deferred deep links. For a user who installs
             from an eligible ad, Firebase Analytics writes the ad group's App URL
             into google.analytics.deferred.deeplink.prefs. MainActivity listens
             for that value and hands it to the same one-shot Flutter wallpaper
             target used by App Links and Play Install Referrer. -->
        <meta-data
            android:name="google_analytics_deferred_deep_link_enabled"
            android:value="true"/>
        <!-- enableOnBackInvokedCallback = predictive back. The manifest default is
             FALSE on Android 13-15, so WITHOUT this the gesture is dead across most
             of the install base. Flutter 3.38+ then supplies the page transition. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode|colorMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- uiMode|colorMode are LOAD-BEARING: applying a wallpaper makes the OS
                 recolor (Material You) and recreate the activity. Handling both here
                 keeps the app alive through apply; dropping either = cold restart on
                 every apply (flutter/flutter#133722). -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <!-- Hand an incoming VIEW intent's PATH to the Flutter router as the
                 initial route. Without this the App Link below still opens the
                 app, but lands it on `/` with the wallpaper id nowhere — so a
                 tap on a shared wallpaper would open the plain feed and look
                 like the deep link simply doesn't work.
                 Scoped by the intent-filters on this activity, so it cannot
                 affect the arul:// PhonePe return (that carries no path). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- arul:// return scheme: PhonePe brings the app back to the
                 foreground with this after the payment flow (the appSchema
                 passed to startTransaction). Rename of the reference's pakiza://. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="arul"/>
            </intent-filter>
            <!-- Android App Link for wallpaper shares and ad creatives:
                 https://arul.hsrutility.com/w/<wallpaper-id>.

                 autoVerify="true" is what makes an INSTALLED app intercept the
                 link ahead of the browser. Android verifies it by fetching
                 https://arul.hsrutility.com/.well-known/assetlinks.json (served
                 by the Arul Worker) and matching this package against the
                 SHA-256 fingerprints there. Three things must agree or the link
                 silently opens a browser with nothing logged: the host below,
                 the wrangler.toml custom domain, and ANDROID_CERT_SHA256 — and
                 the fingerprint must be the PLAY APP SIGNING cert, not just the
                 upload key, or verification fails on every Play install while
                 working perfectly on a locally-built APK.

                 android:host is duplicated in kDeepLinkHost (Dart), which is
                 what actually builds the outgoing links.

                 Kept SEPARATE from the arul:// filter above: they cannot merge.
                 An intent-filter matches the cross product of its schemes and
                 hosts, so folding https in would also register arul://arul.hsrutility.com
                 and — worse — put the PhonePe return scheme under autoVerify. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="arul.hsrutility.com"
                    android:pathPrefix="/w/"/>
            </intent-filter>
        </activity>

        <!-- Don't delete: used by the Flutter tool to generate GeneratedPluginRegistrant. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- PostHog is initialised in Dart (main.dart: Posthog().setup() with the
             POSTHOG_KEY dart-define), never from the manifest. Disable the
             plugin's native manifest auto-init so it doesn't try — and fail — to
             configure PostHog from a com.posthog.posthog.API_KEY meta-data we
             deliberately don't ship: that path logged
             `E/PostHog: Either …API_KEY must be provided!` on every launch.
             With AUTO_INIT=false the plugin skips it (a benign info log instead)
             and the Dart setup() stays the single source of truth. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />

        <!-- Meta (Facebook) App Events. App id + client token are injected at
             build time from dart-defines (META_APP_ID / META_CLIENT_TOKEN) via
             gradle manifestPlaceholders — no config lives in the repo. When the
             defines are absent (dev without keys, or the placeholder in prod.json
             pre-provisioning), gradle substitutes empty placeholders, the values
             below resolve to a bare "fb"/"" and the SDK stays effectively inert;
             we ALSO gate the Dart side via AppConfig.metaEnabled so no events are
             sent. The `fb`-prefix on ApplicationId is Meta's required string form.
             Auto-init + auto-logging ON (Android-only v1, no iOS ATT): this
             captures the install/launch events Meta Ads needs for attribution
             automatically; the ★ conversion events are logged explicitly via
             MetaAnalyticsService. Advertiser-ID collection ON for install
             attribution — the shared hsrutility.com privacy policy must keep
             disclosing it (docs/analytics-ops.md). -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="fb${facebookAppId}" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="${facebookClientToken}" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />

        <!-- Impeller ON. Do NOT flip this to chase the green-edge-strip artifact on
             live wallpapers: it was tested against Skia on the reference app and the
             strip is IDENTICAL, because Flutter backs TextureRegistry.SurfaceProducer
             with an ImageReader on BOTH renderers, and the ImageReader consumer is
             where the decoder's crop rect gets dropped (flutter#174026, #159955).
             The only fix is content-side: video width % 128 == 0 AND height % 32 == 0
             (docs/media-conventions.md). Confirm via logcat: "Using the Impeller
             rendering backend". -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true"/>

        <!-- The applied live wallpaper IS this service: it reads the downloaded MP4
             from app-internal storage and loops it on the home screen via Media3
             (wallpaper/VideoRenderer). exported + BIND_WALLPAPER lets the system bind
             to it securely; the meta-data points at the @xml/video_wallpaper
             descriptor Android requires of every live wallpaper. -->
        <service
            android:name=".wallpaper.ArulVideoWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService"/>
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/video_wallpaper"/>
        </service>

        <!-- Hands a local image file to the system wallpaper chooser as a content://
             URI (the ACTION_ATTACH_DATA fallback in the static apply path). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wallpaper_file_paths"/>
        </provider>

        <!-- flutter_local_notifications: fires scheduled reminders, and re-arms
             the whole schedule after a reboot. The boot receiver is NOT optional
             — the reminders are one-shot alarms held by AlarmManager, which the
             OS clears on restart, so without it a phone that reboots once stops
             notifying until the app is next opened. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- share_plus needs this to enumerate apps that can receive a share. -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!-- url_launcher: mailto: for the support email. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>

    <!-- Detect whether WhatsApp is installed for the targeted referral AND
         wallpaper shares. w4b (WhatsApp Business) is a separate package with the
         same whatsapp:// scheme — without it, a user who runs only Business
         silently falls through to the generic share sheet. -->
    <queries>
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
    </queries>

    <!-- PhonePe SDK + our own UpiIntentChannel — enumerate UPI apps for
         intent-based payment. REQUIRED on Android 11+: without this,
         package-visibility rules hide every UPI app, the picker lists nothing,
         no payment app can be launched, and the mandate setup dies with a
         generic failure. Every package in UpiIntentChannel.MANDATE_APPS must
         appear here. Ported from the reference app, extended for the direct
         UPI-intent mandate flow (BHIM, CRED, SuperMoney, PhonePe simulator). -->
    <queries>
        <package android:name="com.phonepe.app"/>
        <package android:name="com.google.android.apps.nbu.paisa.user"/>
        <package android:name="net.one97.paytm"/>
        <package android:name="in.amazon.mShop.android.shopping"/>
        <package android:name="com.axis.mobile"/>
        <package android:name="com.whatsapp"/>
        <package android:name="in.org.npci.upiapp"/>
        <package android:name="com.dreamplug.androidapp"/>
        <package android:name="money.super.payments"/>
        <package android:name="com.phonepe.simulator"/>
        <!-- Resolve upi:// (and the sandbox simulator's ppesim://) view intents. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="ppesim"/>
        </intent>
    </queries>
</manifest>
