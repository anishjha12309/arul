<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Static apply needs WallpaperManager -> normal permission, auto-granted -> live uses the chooser and needs none. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <!-- Without WRITE_SETTINGS every "Set" fails Settings.System.canWrite -> RingtoneManager cannot write a device tone. -->
    <!-- Special-access -> it shows on the Play listing -> the store form must justify it (docs/known-issues.md §Open). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <!-- Pre-API-29 a tone goes to the PUBLIC Ringtones dir and the EXTERNAL MediaStore volume -> both need this permission. -->
    <!-- maxSdkVersion=28 -> it never reaches a modern device or the Play permission list -> Android 10+ needs nothing. -->
    <!-- Runtime-prompted at the first "Set" on those devices, never at launch -> see MainActivity.setRingtone. -->
    <!-- Same shape as Pakiza's -> shared behaviour, fix it in both repos (CLAUDE.md §0). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Prompted on Android 13+ only when the user turns reminders on -> never at launch. -->
    <!-- Nothing is scheduled while the master toggle is off -> the permission stays unasked. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Reminders are one-shot alarms -> a reboot drops every pending one -> this re-arms them via the boot receiver below. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Live wallpaper support is OPTIONAL -> the app installs on devices without it -> apply degrades to static-only. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <!-- Install from an eligible Ads creative -> Firebase writes its App URL into google.analytics.deferred.deeplink.prefs. -->
        <!-- MainActivity reads that value -> it feeds the same one-shot Flutter target as App Links and Play Install Referrer. -->
        <meta-data
            android:name="google_analytics_deferred_deep_link_enabled"
            android:value="true"/>
        <!-- No manifest defaults -> events ship without ad_user_data/ad_personalization -> GA4 drops the acquisition source. -->
        <!-- Manifest defaults apply BEFORE first_open -> a Dart-side setConsent() cannot -> they must live here. -->
        <!-- Arul serves India only -> no consent banner is required there -> scope these per region before any EEA release. -->
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="true"/>
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="true"/>
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="true"/>
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="true"/>
        <!-- The predictive-back flag defaults to FALSE on Android 13-15 -> without it the gesture is dead on most installs. -->
        <!-- Flutter 3.38+ supplies the page transition -> nothing app-side draws it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode|colorMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Applying a wallpaper makes the OS recolor and recreate the activity -> uiMode|colorMode are LOAD-BEARING. -->
            <!-- Drop either one -> the app cold-restarts on every apply (flutter/flutter#133722). -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <!-- Off -> an App Link still opens the app but lands on `/` with the wallpaper id nowhere -> it looks broken. -->
            <!-- Scoped to this activity's filters -> the arul:// PhonePe return carries no path -> it cannot be affected. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- PhonePe returns the user via this scheme -> it is the appSchema passed to startTransaction -> keep the two in step. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="arul"/>
            </intent-filter>
            <!-- Link shapes, ids and the ?lang= parameter: docs/deep-links.md. -->
            <!-- autoVerify="true" is what makes an INSTALLED app intercept the link ahead of the browser. -->
            <!-- Android verifies via /.well-known/assetlinks.json on that host -> the Worker serves it -> it must list this SHA-256. -->
            <!-- Host here, wrangler.toml's custom domain and ANDROID_CERT_SHA256 must agree -> a mismatch silently opens a browser. -->
            <!-- Use the PLAY APP SIGNING cert, not the upload key -> a local APK verifies, every Play install fails. -->
            <!-- android:host is duplicated in kDeepLinkHost (Dart) -> that is what builds outgoing links -> change both. -->
            <!-- A filter matches the CROSS PRODUCT of schemes and hosts -> merging https here would register arul://arul.hsrutility.com. -->
            <!-- Worse, it would put the PhonePe return scheme under autoVerify -> never merge the two filters. -->
            <!-- Multiple <data> elements in ONE filter merge into every combined variation -> declare one filter per URL shape. -->
            <!-- The /w/ + /r/ merge was harmless, same scheme and host -> this split is the documented shape, not a bug fix. -->
            <!-- Never cite it as the cure for Ads' "deep link wasn't found" on /r/ -> that was a stale scan on Google's side. -->
            <!-- Add a new path as a new FILTER anyway -> it costs nothing and matches the docs. -->
            <!-- autoVerify on one http/https filter verifies the host across ALL of them -> putting it on both is free. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="arul.hsrutility.com"
                    android:pathPrefix="/w/"/>
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="arul.hsrutility.com"
                    android:pathPrefix="/r/"/>
            </intent-filter>
            <!-- fb<APP_ID>://open?wallpaper_id=…&lang=… (or ?screen=ringtones&ringtone_id=…) is what FB/IG launch for an INSTALLED user. -->
            <!-- The id reuses the SDK meta-data's META_APP_ID placeholder -> the scheme can never drift from the SDK's app. -->
            <!-- A key-less dev build resolves to a bare "fb" scheme -> nothing ever sends it -> harmless. -->
            <!-- The NOT-installed half of the same ad is the SDK's deferred fetch in MainActivity -> not this filter. -->
            <!-- Its own filter on purpose -> merged into the https one it would register fb…://arul.hsrutility.com under autoVerify. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="fb${facebookAppId}"
                    android:host="open"/>
            </intent-filter>
        </activity>

        <!-- The Flutter tool reads this to generate GeneratedPluginRegistrant -> never delete it. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- PostHog is set up in Dart from a dart-define -> no API_KEY meta-data ships -> native auto-init errored every launch. -->
        <!-- AUTO_INIT=false skips that path -> the Dart setup() stays the single source of truth. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />

        <!-- App id and client token are injected from dart-defines via gradle manifestPlaceholders -> no Meta config in the repo. -->
        <!-- Defines absent -> values resolve to a bare "fb"/"" and the SDK goes inert -> AppConfig.metaEnabled gates Dart as well. -->
        <!-- The `fb` prefix on ApplicationId is Meta's required string form -> not a typo. -->
        <!-- Auto-logging ON -> Meta Ads gets the install/launch events attribution needs -> ★ events go via MetaAnalyticsService. -->
        <!-- Advertiser-ID collection ON for install attribution -> the privacy policy must keep disclosing it (docs/analytics-ops.md). -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="fb${facebookAppId}" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="${facebookClientToken}" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />

        <!-- Never flip this to chase the green-edge strip on live video -> Skia was tested and the strip is IDENTICAL. -->
        <!-- Both renderers back SurfaceProducer with an ImageReader -> its consumer drops the crop rect (flutter#174026, #159955). -->
        <!-- The only fix is content-side: width % 128 == 0 AND height % 32 == 0 (docs/media-conventions.md). -->
        <!-- Confirm the backend in logcat: "Using the Impeller rendering backend". -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true"/>

        <!-- The applied live wallpaper IS this service -> it loops the downloaded MP4 from internal storage (wallpaper/VideoRenderer). -->
        <!-- exported plus BIND_WALLPAPER -> only the system may bind to it -> neither attribute is optional. -->
        <service
            android:name=".wallpaper.ArulVideoWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService"/>
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/video_wallpaper"/>
        </service>

        <!-- The ACTION_ATTACH_DATA fallback needs a content:// URI for a local image -> this provider mints it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/wallpaper_file_paths"/>
        </provider>

        <!-- Reminders are one-shot AlarmManager alarms -> a reboot clears them -> the boot receiver is NOT optional. -->
        <!-- Lose it and a phone that reboots once stops notifying until the app is next opened. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- share_plus enumerates apps that can receive a share -> package visibility hides them without this. -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!-- url_launcher opens mailto: for the support email -> package visibility hides the handler without this. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>

    <!-- WhatsApp detection drives the targeted referral and wallpaper shares -> both packages must be listed. -->
    <!-- w4b (Business) is a separate package on the same scheme -> omit it and Business-only users fall to the generic sheet. -->
    <queries>
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
    </queries>

    <!-- REQUIRED on Android 11+ -> package visibility hides every UPI app -> the picker lists nothing and mandate setup dies. -->
    <!-- Every package in UpiIntentChannel.MANDATE_APPS must appear here -> a missing one is invisible to the picker. -->
    <queries>
        <package android:name="com.phonepe.app"/>
        <package android:name="com.google.android.apps.nbu.paisa.user"/>
        <package android:name="net.one97.paytm"/>
        <package android:name="in.amazon.mShop.android.shopping"/>
        <package android:name="com.axis.mobile"/>
        <package android:name="com.whatsapp"/>
        <package android:name="in.org.npci.upiapp"/>
        <package android:name="com.dreamplug.androidapp"/>
        <package android:name="money.super.payments"/>
        <package android:name="com.phonepe.simulator"/>
        <!-- Resolve upi:// and the sandbox simulator's ppesim:// VIEW intents. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="ppesim"/>
        </intent>
    </queries>
</manifest>
